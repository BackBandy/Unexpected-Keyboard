<?xml version="1.0" encoding="utf-8"?>
<keyboard name="두벌식 (Custom)" script="hangul">
  <!-- Row 1: Numbers -->
  <row>
    <key key0="1" key1="loc esc" key2="!" key4="`"/>
    <key key0="2" key2="@" key3="~"/>
    <key key0="3" key2="#"/>
    <key key0="4" key2="$"/>
    <key key0="5" key2="%"/>
    <key key0="6" key2="^"/>
    <key key0="7" key2="&amp;"/>
    <key key0="8" key2="*"/>
    <key key0="9" key1="-" key3="_"/>
    <key key0="0" key1="+" key3="="/>
  </row>
  <!-- Row 2: Korean jamo (QWERTY q-p) with swipe double consonants -->
  <row>
    <key key0="ㅂ" key1="loc tab" key2="1" key3="ㅄ" key4="ㅃ"/>
    <key key0="ㅈ" key1="~" key2="2" key3="ㄵ" key4="ㅉ"/>
    <key key0="ㄷ" key1="!" key2="3" key4="ㄸ"/>
    <key key0="ㄱ" key1="\@" key2="4" key3="ㄺ" key4="ㄲ"/>
    <key key0="ㅅ" key1="\#" key2="5" key3="ㄳ" key4="ㅆ"/>
    <key key0="ㅛ" key1="$" key2="6" key3="&lt;" key4="&gt;"/>
    <key key0="ㅕ" key1="%" key2="7" key3="(" key4=")"/>
    <key key0="ㅑ" key1="^" key2="8" key3="{" key4="}"/>
    <key key0="ㅐ" key1="&amp;" key2="9" key3="[" key4="ㅒ"/>
    <key key0="ㅔ" key1="*" key2="0" key3="]" key4="ㅖ"/>
  </row>
  <!-- Row 3: Korean jamo (QWERTY a-l) -->
  <row>
    <key shift="0.5" key0="ㅁ" key2="`" key3="menu"/>
    <key key0="ㄴ" key3="ㄼ"/>
    <key key0="ㅇ" key3="ㄻ"/>
    <key key0="ㄹ" key1="-" key2="_" key3="ㄽ"/>
    <key key0="ㅎ" key1="=" key2="+" key3="ㅀ" key4="ㄶ"/>
    <key key0="ㅗ" key1="{" key2="}" key3="ㅚ"/>
    <key key0="ㅓ" key1="[" key2="]" key3="ㅘ"/>
    <key key0="ㅏ" key1="(" key2=")" key3=";" key4=":"/>
    <key key0="ㅣ" key1="|" key2="\\" key3="'" key4="&quot;"/>
  </row>
  <!-- Row 4: Korean jamo (QWERTY z-m) -->
  <row>
    <key width="1.5" role="action" key0="shift" key2="loc capslock"/>
    <key key0="ㅋ" key2="undo"/>
    <key key0="ㅌ" key1="ㄾ" key2="cut" key3="&lt;" key4="&gt;"/>
    <key key0="ㅊ" key2="copy" key3="."/>
    <key key0="ㅍ" key1="ㄿ" key2="paste" key3=","/>
    <key key0="ㅠ" key1="ㅞ" key2="ㅝ" key3="/" key4="\?"/>
    <key key0="ㅜ" key2="ㅟ" key3=";" key4=":"/>
    <key key0="ㅡ" key2="ㅢ" key3="'" key4="&quot;"/>
    <key width="1.5" role="action" key0="backspace" key2="delete"/>
  </row>
</keyboard>
